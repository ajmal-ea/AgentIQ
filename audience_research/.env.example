# Audience Research Environment Configuration

# Tavily API Key - Required for web search functionality
# Create an account at https://tavily.com/ to get your API key
TAVILY_API_KEY=your_tavily_api_key_here

# NVIDIA API Key - Required for NIM language models
# Get your API key from https://www.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenAI API Key - Required for OpenAI language models
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here 