# Tavily API Key - Required for web search capabilities
# Sign up at https://tavily.com/ to get your API key
TAVILY_API_KEY=your_tavily_api_key_here

# NVIDIA API Key - Optional, used for LLM-based analysis with NeMo models
# Sign up at https://build.nvidia.com/ to get your API key
NVIDIA_API_KEY=your_nvidia_api_key_here

# Groq API Key - Optional, used for validation and fallback
# Sign up at https://console.groq.com/ to get your API key
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key - Optional
OPENAI_API_KEY=your_openai_key_here

# Azure OpenAI API Key - Optional
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here

# Tracing settings
ENABLE_TRACING=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOGGING_LEVEL=INFO

# Cache settings to minimize API calls
ENABLE_CACHE=true
CACHE_EXPIRY_SECONDS=3600 # 1 hour cache expiry

# Anthropic API Key (optional - for using Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tracing settings (optional)
# PHOENIX_HOST=your_phoenix_host
# PHOENIX_PORT=your_phoenix_port

# Logging level (default: INFO)
# LOG_LEVEL=INFO

# Cache settings (optional)
# CACHE_DIR=./cache 